# Abendausgabe – Umgebungsvariablen. Nach .env kopieren, .env nie committen.
# Anderes Image als das fertige aus der Registry (Fork, selbst gebaut):
# ABEND_IMAGE=ghcr.io/<konto>/abendausgabe:latest
ABEND_PORT=8470
# heute: Tagesablauf aus tagesschau und Wetter vor acht | test: Testsendung aus config/dummy_rundown.yaml
ABEND_PROGRAM=heute
# Sekunden, bis eine Frage ohne alle Antworten aufgelöst wird
ABEND_ASK_TIMEOUT_S=45
# Video für den YouTube-Test auf /tv/check.html
ABEND_YOUTUBE_TEST_ID=jNQXAC9IVRw
# true erst, wenn HTTPS über den Reverse Proxy läuft
ABEND_COOKIE_SECURE=false
# Morgen danach: Uhrzeit für den Push (HH:MM, „aus“ schaltet ab). Jede Person schaltet ihn im Profil selbst ein.
ABEND_MORNING_PUSH=08:30
# ntfy-Server für den Push; eigener Server statt ntfy.sh möglich
ABEND_NTFY_URL=https://ntfy.sh

# Redaktion (decisions.md Nr. 63). Derselbe zufällige Token auf Server und Mac, z. B. `openssl rand -hex 32`.
# Leer: Der Server bietet keine Redaktions-API an, die Sendung zeigt Schlagzeilen im Original.
# ABEND_REDAKTION_TOKEN=
# Nur auf dem Mac: Adresse des Servers und lokales Modell über Ollama
# ABEND_SERVER_URL=http://192.168.178.10:8470
# ABEND_LLM_PROVIDER=ollama
# ABEND_OLLAMA_URL=http://localhost:11434
# ABEND_MODEL_TRANSLATE=translategemma:12b
# Höchstdauer eines Redaktionslaufs in Minuten
# ABEND_REDAKTION_MAX_MIN=15

# Später (Claude-API, decisions.md Nr. 54)
# ANTHROPIC_API_KEY=
# ABEND_MODEL_TRIAGE=claude-haiku-5-5
# ABEND_MODEL_EDITOR=claude-sonnet-5-5
# ABEND_LLM_BUDGET_EUR=1.00
# NCBI_API_KEY=
